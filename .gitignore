.venv/
venv/
node_modules/
frontend/node_modules/
frontend/dist/
*.tsbuildinfo
.env
.env.local
frontend/.env
frontend/.env.local
.DS_store
__pycache__/
*.pyc
backend/smartlend.db

# Large ML Artifacts
backend/artifacts/*.joblib
backend/artifacts/*.csv

# Raw datasets (large; fetched via kaggle CLI, not committed)
data/raw/**/*.csv
data/raw/**/*.zip
!data/raw/**/*columns_description*.csv

# Derived feature matrices (regenerate: python -m research.features.engineer)
data/processed/

# Agent worktrees / session cache (hundreds of MB)
.claude/

# Model weights - fetched, not committed. See models/README.md
models/**/*.ckpt
models/**/*.safetensors
models/**/*.bin

# TabPFN Colab exports - derived from Home Credit data, which may not be
# redistributed. Regenerate with `python -m backend.export_tabpfn_context`.
models/tabpfn/tabpfn_context.csv
models/tabpfn/tabpfn_eval_rows.csv
models/tabpfn/tabpfn_export_manifest.json

# CatBoost training logs (regenerated on every run)
catboost_info/

# SQLite runtime sidecar files
data/*.db-shm
data/*.db-wal

# Scratch intermediates and retired artifacts
reports/_*.npy
backend/artifacts/*.bak
scripts/_*.json

# Dev-server logs (written by start.sh / start.bat)
*_dev.log
*_dev.err.log

# UCI Taiwan credit dataset — fetched via OpenML by the replication script
# (research/analysis/taiwan_replication.py); third-party data, not committed.
data/raw/uci_taiwan/

# Terraform — state holds EVERY attribute including secrets; never commit.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
!terraform/terraform.tfvars.example
terraform/*.tfplan
terraform/tfplan
