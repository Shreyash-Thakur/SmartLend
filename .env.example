# SmartLend — environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is not,
# so it must never contain a real secret.

# ElevenLabs text-to-speech (voice features).
# Issue a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional ElevenLabs tuning (safe to leave blank; sensible defaults are used).
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Sarvam AI speech-to-text (Indian-language voice intake).
# Issue a key at https://dashboard.sarvam.ai/  — leave blank to run without
# voice intake; the API degrades to HTTP 503 on /api/voice/transcribe.
SARVAM_API_KEY=
SARVAM_STT_MODEL=

# Reviewer-briefing agent (Agent Briefing panel on the review page).
# Set ONE of these; the first one set wins, in this order.
# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Google Gemini, free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Ollama, local and free, no internet: install from https://ollama.com, run
# `ollama pull llama3.1:8b`, then set the model name here.
OLLAMA_MODEL=
# Optional; defaults to http://localhost:11434
OLLAMA_URL=
