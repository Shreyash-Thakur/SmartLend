# SmartLend — environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is not,
# so it must never contain a real secret.

# ElevenLabs text-to-speech (voice features).
# Issue a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional ElevenLabs tuning (safe to leave blank; sensible defaults are used).
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Sarvam AI speech-to-text (Indian-language voice intake).
# Issue a key at https://dashboard.sarvam.ai/  — leave blank to run without
# voice intake; the API degrades to HTTP 503 on /api/voice/transcribe.
SARVAM_API_KEY=
SARVAM_STT_MODEL=
